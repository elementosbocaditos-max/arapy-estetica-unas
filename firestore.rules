rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================================================
    // ÓRBITA ARAPY SOLUCIONES — REGLAS MULTI-SALÓN (arapy_salones/{salonId})
    // Cada salón vive aislado en su propio documento raíz y subcolecciones.
    // La Consola Master de Arapy gestiona suscripciones (status, expiresAt, plan).
    // ========================================================================
    match /arapy_salones/{salonId} {
      // Lectura pública para resolver slug y validar suscripción activa
      allow read: if true;
      // Permite actualizar metadata comercial; en producción restringir campos
      // de suscripción (status, plan, expiresAt) únicamente al admin de Consola Master.
      allow create, update: if true;
      allow delete: if request.auth != null;

      // Configuración del salón (nombre, portada, horarios, alias, tema, PIN)
      match /salon/{docId} {
        allow read, write: if true;
      }

      // Categorías, Servicios, Adicionales, Galería Inspo y Banco de Fotos
      match /categories/{docId} {
        allow read, write: if true;
      }
      match /services/{docId} {
        allow read, write: if true;
      }
      match /addons/{docId} {
        allow read, write: if true;
      }
      match /inspo/{docId} {
        allow read, write: if true;
      }
      match /photoBank/{docId} {
        allow read, write: if true;
      }
      match /blockedSlots/{docId} {
        allow read, write: if true;
      }

      // Turnos / Agenda (las clientas leen horarios ocupados y crean reservas)
      match /appointments/{appointmentId} {
        allow read, create, update, delete: if true;
      }

      // Fichas de Clientas (se crean y actualizan automáticamente al reservar)
      match /clients/{clientId} {
        allow read, create, update, delete: if true;
      }

      // Finanzas, Gastos y Caja
      match /finances/{docId} {
        allow read, write: if true;
      }
    }
  }
}
