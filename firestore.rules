rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos públicos del salón (nombre, horarios, contacto, seña)
    match /salon/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Categorías y Servicios
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /services/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Galería Inspo
    match /inspo/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Turnos / Agenda
    match /appointments/{appointmentId} {
      // Las clientas pueden ver turnos para validar horarios ocupados y pueden agendar
      allow read, create: if true;
      // Solo la dueña o usuario autenticado puede actualizar o cancelar turnos
      allow update, delete: if request.auth != null;
    }

    // Fichas de Clientas
    match /clients/{clientId} {
      // Se crean al reservar, lectura y edición restringida a la dueña
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Finanzas, Gastos y Caja
    match /finances/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
